---
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { blogUrl } from '../../lib/urls';
import { business } from '../../data/business';

// Newest first.
const posts = (await getCollection('blog')).sort(
  (a, b) => Date.parse(b.data.publishDate) - Date.parse(a.data.publishDate),
);

// Badge classes by category; unknown categories reuse the "news" look.
const badges: Record<string, string> = {
  emergency: 'bg-red-100 text-red-700',
  tips: 'bg-brand-100 text-brand-700',
  maintenance: 'bg-amber-100 text-amber-700',
  news: 'bg-stone-200 text-stone-700',
};

const longDate = (iso: string) =>
  new Date(`${iso}T00:00:00`).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout
  title={`Plumbing Advice and News | ${business.name}`}
  description="Maintenance guides, how-tos and local news from Riverbend Plumbing Co for homeowners in Fairmont and Harlan County, TX."
>
  <Breadcrumbs crumbs={[{ label: 'Blog' }]} />

  <section class="mx-auto max-w-7xl px-5 py-10 lg:px-8 lg:py-16">
    <div class="text-center">
      <h1 class="font-display text-3xl text-brand-900 sm:text-4xl lg:text-5xl">Plumbing Advice and News</h1>
      <p class="mx-auto mt-4 max-w-2xl text-stone-600">
        Guides and updates from the {business.name} team, written to help your pipes last longer.
      </p>
    </div>

    {posts.length === 0 ? (
      <p class="mt-12 text-center text-stone-500">Nothing here yet. New articles are coming.</p>
    ) : (
      <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => (
          <a
            href={blogUrl(post.id)}
            class="card-hover group flex flex-col rounded-xl border border-stone-200 bg-white"
          >
            <div class="flex flex-1 flex-col p-6">
              <div class="flex items-center gap-3">
                <span class={`inline-block rounded-full px-2.5 py-0.5 text-xs font-semibold capitalize ${badges[post.data.category] ?? badges.news}`}>
                  {post.data.category}
                </span>
                {post.data.readingTime && (
                  <span class="flex items-center gap-1 text-xs text-stone-400">
                    <Icon name="lucide:clock" class="size-3" />
                    {post.data.readingTime}
                  </span>
                )}
              </div>

              <h2 class="mt-3 font-display text-lg text-brand-900 group-hover:text-brand-700">{post.data.title}</h2>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-stone-600">{post.data.description}</p>

              <div class="mt-4 flex items-center gap-2 border-t border-stone-100 pt-4 text-xs text-stone-400">
                <Icon name="lucide:calendar" class="size-3.5" />
                <time datetime={post.data.publishDate}>{longDate(post.data.publishDate)}</time>
                <span class="text-stone-300">|</span>
                <span>{post.data.author}</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    )}
  </section>
</BaseLayout>
