---
import type { ServiceArea } from '../data/serviceAreas';
import type { ServiceType } from '../data/serviceTypes';
import { serviceTypes } from '../data/serviceTypes';
import { getAreaBySlug } from '../data/serviceAreas';
import { comboUrl, areaUrl } from '../lib/urls';

interface Props {
  area: ServiceArea;
  service?: ServiceType;
}

const { area, service } = Astro.props;

// Siblings: every service except the one on this page (all of them on an area page).
const siblingServices = serviceTypes.filter((s) => s.slug !== service?.slug);

// `nearby` holds slugs; turn them into area objects and drop any that no longer exist.
const neighbours = area.nearby
  .map((slug) => getAreaBySlug(slug))
  .filter((a): a is ServiceArea => Boolean(a));

const pill =
  'rounded-full border border-stone-200/60 bg-white px-3.5 py-1.5 text-xs font-medium text-stone-600 transition-all hover:border-brand-300 hover:bg-brand-50 hover:text-brand-700';
const label = 'text-sm font-semibold uppercase tracking-wide text-stone-400';
---

<nav aria-label="Related pages" class="mt-12 space-y-8">
  {siblingServices.length > 0 && (
    <div>
      <h3 class={label}>{service ? `More services in ${area.name}` : `Services in ${area.name}`}</h3>
      <div class="mt-3 flex flex-wrap gap-2">
        {siblingServices.map((s) => (
          <a href={comboUrl(area.slug, s.slug)} class={pill}>{s.name}</a>
        ))}
      </div>
    </div>
  )}

  {neighbours.length > 0 && (
    <div>
      <h3 class={label}>{service ? `${service.name} nearby` : 'Nearby areas'}</h3>
      <div class="mt-3 flex flex-wrap gap-2">
        {neighbours.map((a) => (
          <a href={service ? comboUrl(a.slug, service.slug) : areaUrl(a.slug)} class={pill}>{a.name}</a>
        ))}
      </div>
    </div>
  )}
</nav>
