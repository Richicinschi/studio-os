/**
 * schema.org OpeningHoursSpecification entries built from `business.hours`.
 * Rows without days or without a valid HH:MM open and close time are skipped,
 * so unfilled tokens and closed days never reach the markup.
 */
export function openingHoursSchema() {
  const time = /^\d{2}:\d{2}$/;
  return business.hours
    .filter((h) => h.dayOfWeek.length > 0 && time.test(h.opens) && time.test(h.closes))
    .map((h) => ({
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: h.dayOfWeek.map((d) => `https://schema.org/${d}`),
      opens: h.opens,
      closes: h.closes,
    }));
}

/** Whole years since the business started, for "X years of experience" copy. */
export function yearsInBusiness(): number {
  return new Date().getFullYear() - business.yearEstablished;
}
