// ============================================================
// Service types
// ============================================================
// One entry per job the business sells. Each entry yields:
//   /services/<slug>/               the service page
//   /services/<area>/<slug>/        a combo page per area
//   menus, internal links and schema
//
// Slugs are lowercase, hyphenated, URL safe.
// ============================================================

export interface ProcessStep {
  /** e.g. "Inspection" */
  title: string;
  description: string;
}

export interface PriceRange {
  /** Name of the tier or job, e.g. "Hydro jetting" */
  label: string;
  /** Low end in dollars */
  min: number;
  /** High end in dollars */
  max: number;
  /** Optional unit, e.g. "per drain" or "per visit" */
  unit?: string;
}

export interface ServiceType {
  /** e.g. "drain-cleaning" */
  slug: string;
  /** e.g. "Drain Cleaning" */
  name: string;
  /** Compact name for menus and breadcrumbs */
  shortName: string;
  /** One sentence for cards */
  shortDescription: string;
  /** Two or three sentences for full pages and schema */
  description: string;
  /** Picture under /public, e.g. "/images/services/drain-cleaning.webp" */
  image: string;
  /** Lucide name in astro-icon form, e.g. "lucide:droplets" */
  icon: string;
  /** Urgent job? Turns on the emergency banner and badges */
  emergency: boolean;
  /** Show on the homepage? */
  featured: boolean;
  /** Exactly four steps describing the job from start to finish */
  processSteps: ProcessStep[];
  /** One or more priced tiers in USD. Pages show each tier, and use the lowest min and highest max as the headline span. */
  priceRanges: PriceRange[];
  /** Search terms for planning only; never rendered */
  keywords: string[];
  /** Slugs of services that pair well with this one */
  relatedServices: string[];
}

