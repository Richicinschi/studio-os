#!/usr/bin/env bash
# task-brief: copy one task's section out of a plan into its own file, so an
# implementer can read the task in one call and the text never passes through
# the controller's context.
#
# Usage: task-brief PLAN_FILE TASK_NUMBER [OUTFILE]
# Default OUTFILE: <repo-root>/.studio-work/sdd/<plan-basename>/task-<N>-brief.md
# That folder is per plan and per working tree; two runs of the same plan in
# one working tree share it.
#
# A task section starts at a heading like "### Task 4: ..." and ends at the
# next "Task <number>" heading. Headings inside fenced code are ignored.
set -euo pipefail

if [ "$#" -lt 2 ] || [ "$#" -gt 3 ]; then
  echo "usage: task-brief PLAN_FILE TASK_NUMBER [OUTFILE]" >&2
  exit 2
fi

plan_file=$1
task_no=$2
if [ ! -f "$plan_file" ]; then
  echo "no such plan file: $plan_file" >&2
  exit 2
fi

if [ "$#" -eq 3 ]; then
  brief=$3
else
  # Run the sibling through bash instead of executing it: unpacking a package
  # with some tools drops the executable bit.
  here=$(cd "$(dirname "$0")" && pwd)
  workspace=$("${BASH:-bash}" "$here/sdd-workspace" "$plan_file")
  brief="$workspace/task-${task_no}-brief.md"
fi

awk -v want="$task_no" '
  /^```/ { fenced = !fenced }
  !fenced && /^#+[ \t]+Task[ \t]+[0-9]+/ {
    # The requested label is used as a pattern, so "4a" and "1.5" work too.
    inside = ($0 ~ ("^#+[ \t]+Task[ \t]+" want "([^0-9]|$)"))
  }
  inside { print }
' "$plan_file" > "$brief"

if [ ! -s "$brief" ]; then
  echo "task ${task_no} not found in ${plan_file} (no heading matching 'Task ${task_no}')" >&2
  exit 3
fi

lines=$(wc -l < "$brief" | tr -d ' ')
echo "wrote ${brief}: ${lines} lines"
