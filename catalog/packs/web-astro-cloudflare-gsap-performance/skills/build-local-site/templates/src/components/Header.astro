---
import { Icon } from 'astro-icon/components';
import { business } from '../data/business';

// One list drives both the desktop bar and the phone drawer.
const links = [
  { href: '/services/', label: 'Services', icon: 'lucide:wrench' },
  { href: '/areas/', label: 'Service Areas', icon: 'lucide:map-pin' },
  { href: '/about/', label: 'About', icon: 'lucide:info' },
  { href: '/contact/', label: 'Contact', icon: 'lucide:mail' },
];
---

<header
  id="site-header"
  class="sticky top-0 z-50 w-full border-b border-stone-200/60 bg-white/80 backdrop-blur-xl backdrop-saturate-150 transition-shadow duration-300"
>
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-5 lg:px-8">
    <a href="/" class="group flex items-center gap-2.5">
      <div class="flex size-9 items-center justify-center rounded-lg bg-brand-800 transition-colors group-hover:bg-brand-700">
        <!-- Inline SVG wrench: the one place an icon is not pulled from astro-icon -->
        <svg class="size-5 text-brand-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" />
        </svg>
      </div>
      <div class="flex flex-col">
        <span class="font-display text-lg leading-none tracking-tight text-brand-900">Riverbend</span>
        <span class="text-[10px] font-medium uppercase tracking-[0.2em] text-stone-400">Plumbing Co</span>
      </div>
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Main">
      {links.map((l) => (
        <a
          href={l.href}
          class="rounded-lg px-3.5 py-2 text-sm font-medium text-stone-600 transition-colors hover:bg-brand-50 hover:text-brand-800"
        >
          {l.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={business.phoneHref}
        class="inline-flex items-center gap-2 rounded-lg bg-brand-800 px-4 py-2 text-sm font-medium text-white shadow-sm transition-all hover:bg-brand-700 hover:shadow-md"
      >
        <Icon name="lucide:phone" class="size-4" />
        <span class="hidden sm:inline">{business.phone}</span>
        <span class="sm:hidden">Call Now</span>
      </a>

      <button
        type="button"
        id="mobile-menu-btn"
        aria-label="Toggle menu"
        class="inline-flex size-10 items-center justify-center rounded-lg text-stone-500 transition-colors hover:bg-stone-100 hover:text-stone-700 lg:hidden"
      >
        <Icon name="lucide:menu" class="size-5" id="menu-icon-open" />
        <Icon name="lucide:x" class="hidden size-5" id="menu-icon-close" />
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden border-t border-stone-100 bg-white lg:hidden">
    <nav class="mx-auto max-w-7xl space-y-1 px-5 py-4" aria-label="Mobile">
      {links.map((l) => (
        <a
          href={l.href}
          class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium text-stone-700 transition-colors hover:bg-brand-50 hover:text-brand-800"
        >
          <Icon name={l.icon} class="size-4 text-stone-400" />
          {l.label}
        </a>
      ))}
      <div class="pt-2">
        <a
          href={business.phoneHref}
          class="flex w-full items-center justify-center gap-2 rounded-lg bg-brand-800 px-4 py-2.5 text-sm font-medium text-white"
        >
          <Icon name="lucide:phone" class="size-4" />
          Call {business.phone}
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  const byId = (id: string) => document.getElementById(id);

  // Open or close the drawer and swap the burger and close icons.
  byId('mobile-menu-btn')?.addEventListener('click', () => {
    ['mobile-menu', 'menu-icon-open', 'menu-icon-close'].forEach((id) =>
      byId(id)?.classList.toggle('hidden'),
    );
  });

  // A light shadow appears once the page has moved off the top.
  const bar = byId('site-header');
  window.addEventListener(
    'scroll',
    () => bar?.classList.toggle('shadow-sm', window.scrollY > 8),
    { passive: true },
  );
</script>
