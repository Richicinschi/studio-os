---
import { Icon } from 'astro-icon/components';
import { business, yearsInBusiness } from '../../data/business';
import { serviceTypes, getPriceSpan, hasPrices } from '../../data/serviceTypes';
import type { ServiceType } from '../../data/serviceTypes';
import { serviceAreas, getAreaBySlug } from '../../data/serviceAreas';
import { comboUrl, contactUrl } from '../../lib/urls';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SeoFaq from '../../components/SeoFaq.astro';

export function getStaticPaths() {
  return serviceTypes.map((service) => ({
    params: { service: service.slug },
    props: { service },
  }));
}

interface Props {
  service: ServiceType;
}

const { service } = Astro.props;

// The FAQ block wants one area for its wording. This sample uses the home town: change the slug.
const homeArea = getAreaBySlug('fairmont') ?? serviceAreas[0];

const span = getPriceSpan(service);
const pageTitle = `${service.name} in Fairmont and Nearby Towns`;
const metaDescription =
  service.description.length > 155 ? `${service.description.slice(0, 152)}...` : service.description;

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.name,
  description: service.description,
  provider: {
    '@type': business.schemaType,
    name: business.name,
    telephone: business.phone,
    url: business.website,
    address: {
      '@type': 'PostalAddress',
      addressLocality: business.address.city,
      addressRegion: business.address.state,
      postalCode: business.address.zip,
    },
  },
  areaServed: serviceAreas.map((a) => ({
    '@type': 'City',
    name: a.name,
    containedInPlace: { '@type': 'AdministrativeArea', name: a.county },
  })),
  // Price markup only when the service has real prices.
  ...(hasPrices(service)
    ? {
        offers: {
          '@type': 'Offer',
          priceSpecification: {
            '@type': 'PriceSpecification',
            priceCurrency: 'USD',
            minPrice: span.min,
            maxPrice: span.max,
          },
        },
      }
    : {}),
};
---

<BaseLayout title={pageTitle} description={metaDescription} schema={serviceSchema}>
  <Breadcrumbs crumbs={[{ label: 'Services', href: '/services/' }, { label: service.name }]} />

  <section class="mx-auto max-w-7xl px-5 pb-12 pt-8 lg:px-8">
    <div class="lg:flex lg:items-start lg:gap-12">
      <div class="lg:flex-1">
        {service.emergency && (
          <div class="mb-6 inline-flex items-center gap-2 rounded-full bg-red-50 px-4 py-2 text-sm font-medium text-red-700 ring-1 ring-red-200/60">
            <Icon name="lucide:alert-circle" class="size-4 text-red-500" />
            Emergency callouts available day and night
          </div>
        )}

        <h1 class="font-display text-3xl text-brand-900 sm:text-4xl lg:text-5xl">{pageTitle}</h1>
        <p class="mt-6 max-w-3xl text-lg leading-relaxed text-stone-600">{service.description}</p>

        {hasPrices(service) && (
          <div class="mt-6 inline-flex items-center gap-2 rounded-lg bg-brand-50 px-5 py-3 text-sm font-medium text-brand-800 ring-1 ring-brand-200/60">
            <Icon name="lucide:dollar-sign" class="size-4 text-brand-500" />
            Usual price: ${span.min.toLocaleString()} to ${span.max.toLocaleString()}
          </div>
        )}
      </div>

      <div class="mt-8 lg:mt-0 lg:w-96 lg:shrink-0">
        <img
          src={service.image}
          alt={`${service.name} work by ${business.name}`}
          class="rounded-xl shadow-lg"
          width="1024"
          height="1024"
          loading="eager"
        />
      </div>
    </div>
  </section>

  <section class="border-t border-stone-200/60 bg-white py-16">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <h2 class="font-display text-2xl text-brand-900 sm:text-3xl">How a {service.name} job runs</h2>
      <p class="mt-3 max-w-2xl text-stone-600">The same steps every time, so nothing on the day comes as a surprise.</p>

      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {service.processSteps.map((step, n) => (
          <div class="relative rounded-xl border border-stone-200/60 bg-stone-50 p-6">
            <div class="flex size-10 items-center justify-center rounded-full bg-brand-800 text-sm font-bold text-white">
              {n + 1}
            </div>
            <h3 class="mt-4 text-base font-semibold text-stone-900">{step.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-stone-600">{step.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 py-16 lg:px-8">
    <h2 class="font-display text-2xl text-brand-900 sm:text-3xl">Where we offer {service.name}</h2>
    <!-- Counties below are the sample business's; edit them to match serviceAreas. -->
    <p class="mt-3 max-w-2xl text-stone-600">
      We do {service.name.toLowerCase()} in Harlan, Mercer and Dunn Counties. Choose your town for local details.
    </p>

    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {serviceAreas.map((a) => (
        <a
          href={comboUrl(a.slug, service.slug)}
          class="group rounded-xl border border-stone-200/60 bg-white p-5 transition-all hover:border-brand-200 hover:shadow-md"
        >
          <div class="flex items-center gap-3">
            <Icon name="lucide:map-pin" class="size-5 text-brand-500" />
            <span class="font-semibold text-stone-800 group-hover:text-brand-800">{a.name}</span>
          </div>
          <p class="mt-2 text-sm text-stone-500">{a.county}</p>
          <p class="mt-1 text-xs text-stone-400">Arrives in: {a.responseTime}</p>
        </a>
      ))}
    </div>
  </section>

  <div class="border-t border-stone-200/60 bg-white">
    <SeoFaq area={homeArea} service={service} />
  </div>

  <section class="bg-brand-900 py-16">
    <div class="mx-auto max-w-4xl px-5 text-center lg:px-8">
      <h2 class="font-display text-2xl text-white sm:text-3xl">Book {service.name}</h2>
      <p class="mx-auto mt-4 max-w-2xl text-brand-200">
        {business.name} has worked in Fairmont and nearby towns for {yearsInBusiness()} years. Phone for a free estimate or to pick a day.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a
          href={business.phoneHref}
          class="inline-flex items-center gap-2 rounded-lg bg-white px-6 py-3 text-sm font-semibold text-brand-900 shadow-sm transition-all hover:bg-stone-100 hover:shadow-md"
        >
          <Icon name="lucide:phone" class="size-4" />
          {business.phone}
        </a>
        <a
          href={contactUrl()}
          class="inline-flex items-center gap-2 rounded-lg border border-brand-300/40 px-6 py-3 text-sm font-semibold text-white transition-all hover:bg-brand-800"
        >
          <Icon name="lucide:mail" class="size-4" />
          Get a quote
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
