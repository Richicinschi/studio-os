<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="Adoption sequence">
    <mxGraphModel dx="1860" dy="650" grid="1" gridSize="10" page="1" pageWidth="1860" pageHeight="650">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="Adopting Studio OS v2: Prepare, then five phases, then update runs; nothing installed before you decide" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1780" height="30" as="geometry" /></mxCell>
        <mxCell id="3" value="Yellow: you act. Blue: Claude acts. Grey: later. Every phase writes its result into adoption/ in your own setup, so a run can stop and resume at any phase." style="text;html=1;fontSize=13;fontColor=#555555;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1780" height="26" as="geometry" /></mxCell>
        <mxCell id="4" value="BEFORE · PREPARE&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:11px&quot;&gt;you · about 10 minutes (estimate)&lt;/span&gt;" style="swimlane;html=1;startSize=54;rounded=1;arcSize=4;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;swimlaneFillColor=#ffffff;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="220" height="430" as="geometry" /></mxCell>
        <mxCell id="5" value="• Install Claude Code and Git&lt;br&gt;• Clone the kit and open&lt;br&gt;&amp;nbsp;&amp;nbsp;its folder in Claude Code,&lt;br&gt;&amp;nbsp;&amp;nbsp;your setup folder added&lt;br&gt;• Say &amp;quot;start the adoption&amp;quot;&lt;br&gt;&lt;br&gt;Nothing in your own setup&lt;br&gt;is read or touched yet.&lt;br&gt;&lt;br&gt;claude.ai only: paste the&lt;br&gt;kit's Project instructions&lt;br&gt;instead, and follow the&lt;br&gt;same phases by hand." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=nowrap;spacingLeft=10;" vertex="1" parent="4"><mxGeometry x="0" y="64" width="220" height="290" as="geometry" /></mxCell>
        <mxCell id="6" value="nothing written yet" style="shape=note;html=1;size=12;whiteSpace=wrap;fontSize=12;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="4"><mxGeometry x="14" y="370" width="192" height="46" as="geometry" /></mxCell>
        <mxCell id="7" value="1 · AUDIT&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:11px&quot;&gt;Claude · read-only · about 5 min&lt;/span&gt;" style="swimlane;html=1;startSize=54;rounded=1;arcSize=4;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;swimlaneFillColor=#ffffff;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="300" y="110" width="220" height="430" as="geometry" /></mxCell>
        <mxCell id="8" value="• Asks first: may I look?&lt;br&gt;• Reads your setup the way&lt;br&gt;&amp;nbsp;&amp;nbsp;/init reads a project:&lt;br&gt;&amp;nbsp;&amp;nbsp;stack, instruction files,&lt;br&gt;&amp;nbsp;&amp;nbsp;skills, hooks, MCP servers,&lt;br&gt;&amp;nbsp;&amp;nbsp;git remotes&lt;br&gt;• Never opens secrets or&lt;br&gt;&amp;nbsp;&amp;nbsp;data files&lt;br&gt;• Estimates what loads into&lt;br&gt;&amp;nbsp;&amp;nbsp;every session today (tokens)&lt;br&gt;• Lists what the kit covers,&lt;br&gt;&amp;nbsp;&amp;nbsp;partly covers, or misses" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=nowrap;spacingLeft=10;" vertex="1" parent="7"><mxGeometry x="0" y="64" width="220" height="290" as="geometry" /></mxCell>
        <mxCell id="9" value="adoption/inventory.md" style="shape=note;html=1;size=12;whiteSpace=wrap;fontSize=12;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="7"><mxGeometry x="14" y="370" width="192" height="46" as="geometry" /></mxCell>
        <mxCell id="10" value="2 · DECIDE&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:11px&quot;&gt;you answer · one question at a time&lt;/span&gt;" style="swimlane;html=1;startSize=54;rounded=1;arcSize=4;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;swimlaneFillColor=#ffffff;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="560" y="110" width="220" height="430" as="geometry" /></mxCell>
        <mxCell id="11" value="• Confirm your profile and&lt;br&gt;&amp;nbsp;&amp;nbsp;your data rules, before&lt;br&gt;&amp;nbsp;&amp;nbsp;anything that stores&lt;br&gt;• The feature menu: tick&lt;br&gt;&amp;nbsp;&amp;nbsp;modules, then the items&lt;br&gt;&amp;nbsp;&amp;nbsp;inside; take single skills&lt;br&gt;&amp;nbsp;&amp;nbsp;from any other module&lt;br&gt;• Each item is flagged:&lt;br&gt;&amp;nbsp;&amp;nbsp;importance + context cost&lt;br&gt;• Total: &amp;quot;your choice adds&lt;br&gt;&amp;nbsp;&amp;nbsp;~N tokens per session&amp;quot;&lt;br&gt;• Tailoring, ticked items only&lt;br&gt;• Each gap: vet one, write&lt;br&gt;&amp;nbsp;&amp;nbsp;one, or skip&lt;br&gt;• &amp;quot;Not sure&amp;quot; takes the&lt;br&gt;&amp;nbsp;&amp;nbsp;recommended option" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=nowrap;spacingLeft=10;" vertex="1" parent="10"><mxGeometry x="0" y="64" width="220" height="290" as="geometry" /></mxCell>
        <mxCell id="12" value="adoption/features.md" style="shape=note;html=1;size=12;whiteSpace=wrap;fontSize=12;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="10"><mxGeometry x="14" y="370" width="192" height="46" as="geometry" /></mxCell>
        <mxCell id="13" value="3 · SPEC AND PLAN&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:11px&quot;&gt;Claude writes · you approve&lt;/span&gt;" style="swimlane;html=1;startSize=54;rounded=1;arcSize=4;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;swimlaneFillColor=#ffffff;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="820" y="110" width="220" height="430" as="geometry" /></mxCell>
        <mxCell id="14" value="• spec.md: what you chose,&lt;br&gt;&amp;nbsp;&amp;nbsp;how it is tailored, what&lt;br&gt;&amp;nbsp;&amp;nbsp;was ruled out and why&lt;br&gt;• Nothing goes on without&lt;br&gt;&amp;nbsp;&amp;nbsp;your yes&lt;br&gt;• plan.md: one row per item,&lt;br&gt;&amp;nbsp;&amp;nbsp;in waves; wave 1 is the&lt;br&gt;&amp;nbsp;&amp;nbsp;first sitting, at most&lt;br&gt;&amp;nbsp;&amp;nbsp;about 8 rows, the scanner&lt;br&gt;&amp;nbsp;&amp;nbsp;first; the rest wait" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=nowrap;spacingLeft=10;" vertex="1" parent="13"><mxGeometry x="0" y="64" width="220" height="290" as="geometry" /></mxCell>
        <mxCell id="15" value="adoption/spec.md + plan.md" style="shape=note;html=1;size=12;whiteSpace=wrap;fontSize=12;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="13"><mxGeometry x="14" y="370" width="192" height="46" as="geometry" /></mxCell>
        <mxCell id="16" value="4 · INSTALL&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:11px&quot;&gt;wave 1, row by row · on your yes&lt;/span&gt;" style="swimlane;html=1;startSize=54;rounded=1;arcSize=4;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;swimlaneFillColor=#ffffff;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="1080" y="110" width="220" height="430" as="geometry" /></mxCell>
        <mxCell id="17" value="• Row 1 is always the&lt;br&gt;&amp;nbsp;&amp;nbsp;scanner: SkillSpector and&lt;br&gt;&amp;nbsp;&amp;nbsp;the scan-first rule&lt;br&gt;• Empty folder: row 2 builds&lt;br&gt;&amp;nbsp;&amp;nbsp;it (setup-workspace)&lt;br&gt;• Each item: scan, triage,&lt;br&gt;&amp;nbsp;&amp;nbsp;then skip, fold, adapt or&lt;br&gt;&amp;nbsp;&amp;nbsp;adopt; you decide&lt;br&gt;• Steps only you can do:&lt;br&gt;&amp;nbsp;&amp;nbsp;! lines; sign-ins in a&lt;br&gt;&amp;nbsp;&amp;nbsp;separate terminal" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=nowrap;spacingLeft=10;" vertex="1" parent="16"><mxGeometry x="0" y="64" width="220" height="290" as="geometry" /></mxCell>
        <mxCell id="18" value="adoption/decisions.md" style="shape=note;html=1;size=12;whiteSpace=wrap;fontSize=12;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="16"><mxGeometry x="14" y="370" width="192" height="46" as="geometry" /></mxCell>
        <mxCell id="19" value="5 · VERIFY&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:11px&quot;&gt;end of wave 1 · same sitting&lt;/span&gt;" style="swimlane;html=1;startSize=54;rounded=1;arcSize=4;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;swimlaneFillColor=#ffffff;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="1340" y="110" width="220" height="430" as="geometry" /></mxCell>
        <mxCell id="20" value="• Every adopted item shown&lt;br&gt;&amp;nbsp;&amp;nbsp;working: hooks canary,&lt;br&gt;&amp;nbsp;&amp;nbsp;a memory written + found&lt;br&gt;• Resume test in a fresh&lt;br&gt;&amp;nbsp;&amp;nbsp;session in your setup&lt;br&gt;• Context estimated again&lt;br&gt;&amp;nbsp;&amp;nbsp;against the first total&lt;br&gt;• One page: what you have&lt;br&gt;&amp;nbsp;&amp;nbsp;now, how to resume&lt;br&gt;&amp;nbsp;&amp;nbsp;tomorrow" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=nowrap;spacingLeft=10;" vertex="1" parent="19"><mxGeometry x="0" y="64" width="220" height="290" as="geometry" /></mxCell>
        <mxCell id="21" value="adoption/handover.md" style="shape=note;html=1;size=12;whiteSpace=wrap;fontSize=12;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="19"><mxGeometry x="14" y="370" width="192" height="46" as="geometry" /></mxCell>
        <mxCell id="22" value="LATER · UPDATE RUNS&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:11px&quot;&gt;once per kit version&lt;/span&gt;" style="swimlane;html=1;startSize=54;rounded=1;arcSize=4;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;swimlaneFillColor=#ffffff;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="1600" y="110" width="220" height="430" as="geometry" /></mxCell>
        <mxCell id="23" value="• Reads CHANGELOG.md and&lt;br&gt;&amp;nbsp;&amp;nbsp;your decisions.md&lt;br&gt;• Asks only about new or&lt;br&gt;&amp;nbsp;&amp;nbsp;changed items&lt;br&gt;• Nothing decided is&lt;br&gt;&amp;nbsp;&amp;nbsp;asked again" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=nowrap;spacingLeft=10;" vertex="1" parent="22"><mxGeometry x="0" y="64" width="220" height="290" as="geometry" /></mxCell>
        <mxCell id="24" value="decisions.md (appended)" style="shape=note;html=1;size=12;whiteSpace=wrap;fontSize=12;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="22"><mxGeometry x="14" y="370" width="192" height="46" as="geometry" /></mxCell>
        <mxCell id="25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.06;entryX=0;entryY=0.06;strokeColor=#444444;strokeWidth=2;" edge="1" parent="1" source="4" target="7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.06;entryX=0;entryY=0.06;strokeColor=#444444;strokeWidth=2;" edge="1" parent="1" source="7" target="10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.06;entryX=0;entryY=0.06;strokeColor=#444444;strokeWidth=2;" edge="1" parent="1" source="10" target="13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.06;entryX=0;entryY=0.06;strokeColor=#444444;strokeWidth=2;" edge="1" parent="1" source="13" target="16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.06;entryX=0;entryY=0.06;strokeColor=#444444;strokeWidth=2;" edge="1" parent="1" source="16" target="19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.06;entryX=0;entryY=0.06;strokeColor=#444444;strokeWidth=2;" edge="1" parent="1" source="19" target="22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="31" value="update mode: new or changed items only" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=1;dashed=1;strokeColor=#666666;strokeWidth=1.5;fontSize=12;" edge="1" parent="1" source="22" target="10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1710" y="590" /><mxPoint x="670" y="590" /></Array></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
