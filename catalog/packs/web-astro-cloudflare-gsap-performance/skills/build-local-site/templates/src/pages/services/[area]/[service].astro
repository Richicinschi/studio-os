---
import { Icon } from 'astro-icon/components';
import { business, yearsInBusiness } from '../../../data/business';
import { serviceTypes, getPriceSpan, hasPrices } from '../../../data/serviceTypes';
import type { ServiceType } from '../../../data/serviceTypes';
import { serviceAreas, getNearbyAreas } from '../../../data/serviceAreas';
import type { ServiceArea } from '../../../data/serviceAreas';
import { areaUrl, comboUrl, contactUrl } from '../../../lib/urls';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import SeoFaq from '../../../components/SeoFaq.astro';
import SeoRelatedLinks from '../../../components/SeoRelatedLinks.astro';
import SeoServiceAreas from '../../../components/SeoServiceAreas.astro';
import SeoTestimonials from '../../../components/SeoTestimonials.astro';

// One page per (area, service) pair.
export function getStaticPaths() {
  return serviceAreas.flatMap((area) =>
    serviceTypes.map((service) => ({
      params: { area: area.slug, service: service.slug },
      props: { area, service },
    })),
  );
}

interface Props {
  area: ServiceArea;
  service: ServiceType;
}

const { area, service } = Astro.props;
const years = yearsInBusiness();
const nearby = getNearbyAreas(area);
const nearbyList = nearby.map((a) => a.name).join(', ');
const lowerName = service.name.toLowerCase();
const span = getPriceSpan(service);

const pageTitle = `${service.name} in ${area.name}, TX | ${business.name}`;
const pageDescription = `Looking for ${lowerName} in ${area.name}? ${business.name} is licensed, fairly priced and usually there within ${area.responseTime}. Call ${business.phone}.`;
const pageUrl = `${business.website}${comboUrl(area.slug, service.slug)}`;

// Two graph nodes: the Service for this town, and the breadcrumb trail.
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      '@id': `${pageUrl}#service`,
      name: `${service.name} in ${area.name}`,
      description: `${service.description} Covers ${area.name}, ${area.county} and the towns around it.`,
      provider: {
        '@type': business.schemaType,
        '@id': `${business.website}/#business`,
        name: business.name,
        telephone: business.phone,
        url: business.website,
        address: {
          '@type': 'PostalAddress',
          addressLocality: business.address.city,
          addressRegion: business.address.state,
          postalCode: business.address.zip,
          addressCountry: 'US',
        },
        geo: {
          '@type': 'GeoCoordinates',
          latitude: business.coordinates.lat,
          longitude: business.coordinates.lng,
        },
        founder: { '@type': 'Person', name: business.owner },
        foundingDate: `${business.yearEstablished}`,
        hasCredential: {
          '@type': 'EducationalOccupationalCredential',
          credentialCategory: 'License',
          name: business.license,
        },
      },
      areaServed: [
        {
          '@type': 'City',
          name: area.name,
          containedInPlace: { '@type': 'AdministrativeArea', name: area.county },
        },
      ],
      // No prices on file means no offer markup.
      ...(hasPrices(service)
        ? { offers: { '@type': 'AggregateOffer', lowPrice: span.min, highPrice: span.max, priceCurrency: 'USD' } }
        : {}),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: business.website },
        { '@type': 'ListItem', position: 2, name: 'Services', item: `${business.website}/services/` },
        { '@type': 'ListItem', position: 3, name: area.name, item: `${business.website}${areaUrl(area.slug)}` },
        { '@type': 'ListItem', position: 4, name: service.name },
      ],
    },
  ],
};

// The four "why us" cards. Edit the claims to match what the business can truly say.
const reasons = [
  { icon: 'lucide:shield-check', title: 'Licensed and insured', text: `${business.license}. Insured on every job.` },
  { icon: 'lucide:map-pin', title: 'Local owners', text: `${years}+ years working in ${area.name} and ${area.county}.` },
  { icon: 'lucide:clock', title: 'Quick arrival', text: `About ${area.responseTime} to reach ${area.name}. Same-day visits possible.` },
  { icon: 'lucide:badge-check', title: 'Work backed up', text: 'Each repair and install comes with a satisfaction guarantee.' },
];

const promises = ['Free estimates on every job', 'No hidden fees', 'Price agreed before work starts'];
---

<BaseLayout title={pageTitle} description={pageDescription} canonicalUrl={pageUrl} schema={schema}>
  <Breadcrumbs
    crumbs={[
      { label: 'Services', href: '/services/' },
      { label: area.name, href: areaUrl(area.slug) },
      { label: service.name },
    ]}
  />

  <article class="mx-auto max-w-7xl px-5 lg:px-8">
    <!-- 1. Hero and H1 -->
    <header class="pb-10 pt-6 lg:pt-10">
      <div class="lg:flex lg:items-start lg:gap-10">
        <div class="lg:flex-1">
          <div class="flex items-center gap-3 text-brand-600">
            <Icon name={service.icon} class="size-8" />
            <span class="text-sm font-semibold uppercase tracking-wide">Trusted {service.name}</span>
          </div>
          <h1 class="mt-3 font-display text-3xl text-brand-900 sm:text-4xl lg:text-5xl">
            {service.name} in {area.name}, TX
          </h1>
          <p class="mt-4 max-w-3xl text-lg leading-relaxed text-stone-600">{pageDescription}</p>
        </div>
        <div class="mt-6 lg:mt-0 lg:w-80 lg:shrink-0">
          <img
            src={service.image}
            alt={`${service.name} in ${area.name}, TX`}
            class="rounded-xl shadow-lg"
            width="1024"
            height="1024"
            loading="eager"
          />
        </div>
      </div>
    </header>

    <div class="mb-10 overflow-hidden rounded-xl">
      <img
        src={service.image}
        alt={`${service.name} job in ${area.name}, TX`}
        class="h-64 w-full object-cover sm:h-80 lg:h-96"
        width="1408"
        height="768"
        loading="eager"
      />
    </div>

    <!-- 2. Emergency banner, only for urgent services -->
    {service.emergency && (
      <div class="mb-10 flex items-center gap-4 rounded-xl border border-amber-200 bg-amber-50 p-5">
        <div class="flex size-12 shrink-0 items-center justify-center rounded-full bg-amber-100">
          <Icon name="lucide:zap" class="size-6 text-amber-600" />
        </div>
        <div>
          <p class="font-semibold text-amber-900">Urgent {lowerName} in {area.name}, any hour</p>
          <p class="mt-1 text-sm text-amber-700">
            Pipes do not break on a schedule. Phone at any time and we send someone to {area.name} first.
          </p>
        </div>
        <a
          href={business.phoneHref}
          class="ml-auto hidden shrink-0 items-center gap-2 rounded-lg bg-amber-500 px-5 py-2.5 text-sm font-semibold text-white shadow transition-colors hover:bg-amber-600 sm:inline-flex"
        >
          <Icon name="lucide:phone" class="size-4" />
          Call now
        </a>
      </div>
    )}

    <!-- 3. Local description -->
    <section class="prose-editorial max-w-3xl pb-12">
      <h2>{service.name} for {area.name} and {area.county}</h2>
      <p>{service.description}</p>
      <p>
        {business.name} has looked after {area.name} and the rest of {area.county} for {years} years.
        We live nearby, so we know what the local pipes, water and weather do to a house.
        {area.description}
      </p>
      {nearby.length > 0 && (
        <p>
          The same {lowerName} service also reaches {nearbyList}. Wherever you are in the region,
          expect a prompt visit from a licensed crew.
        </p>
      )}
    </section>

    <!-- 4. Price (skipped when the service has no prices) -->
    {hasPrices(service) && (
    <section class="pb-12">
      <div class="rounded-xl border border-stone-200 bg-white p-8 lg:p-10">
        <h2 class="font-display text-2xl text-brand-900 sm:text-3xl">
          Price of {service.name} in {area.name}
        </h2>
        <div class="mt-6 flex items-baseline gap-2">
          <span class="font-display text-4xl text-brand-700">${span.min}</span>
          <span class="text-2xl text-stone-400">&ndash;</span>
          <span class="font-display text-4xl text-brand-700">${span.max}</span>
        </div>
        <p class="mt-3 text-sm text-stone-500">
          A usual range for {lowerName} here. The final figure depends on the size of the job and the parts needed.
        </p>
        {service.priceRanges.length > 1 && (
          <ul class="mt-6 divide-y divide-stone-100 text-sm text-stone-600">
            {service.priceRanges.map((tier) => (
              <li class="flex items-baseline justify-between gap-4 py-2">
                <span>{tier.label}{tier.unit ? ` (${tier.unit})` : ''}</span>
                <span class="font-medium text-stone-800">${tier.min.toLocaleString()} to ${tier.max.toLocaleString()}</span>
              </li>
            ))}
          </ul>
        )}
        <div class="mt-6 flex flex-wrap items-center gap-4">
          {promises.map((p) => (
            <div class="flex items-center gap-2 text-sm text-stone-600">
              <Icon name="lucide:check-circle" class="size-5 text-brand-600" />
              <span>{p}</span>
            </div>
          ))}
        </div>
      </div>
    </section>
    )}

    <!-- 5. Process -->
    <section class="pb-16">
      <h2 class="font-display text-2xl text-brand-900 sm:text-3xl">How {lowerName} works</h2>
      <p class="mt-3 max-w-2xl text-stone-600">Four steps, the same on every visit.</p>

      <div class="mt-10 grid gap-6 sm:grid-cols-2">
        {service.processSteps.map((step, n) => (
          <div class="relative rounded-xl border border-stone-200 bg-white p-6">
            <div class="mb-4 flex size-10 items-center justify-center rounded-full bg-brand-50 font-display text-lg text-brand-700">
              {n + 1}
            </div>
            <h3 class="font-display text-lg text-brand-900">{step.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-stone-600">{step.description}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- 6. Why choose us -->
    <section class="pb-16">
      <h2 class="font-display text-2xl text-brand-900 sm:text-3xl">
        Why {area.name} picks {business.name}
      </h2>

      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {reasons.map((r) => (
          <div class="rounded-xl border border-stone-200 bg-white p-6 text-center">
            <div class="mx-auto flex size-12 items-center justify-center rounded-full bg-brand-50">
              <Icon name={r.icon} class="size-6 text-brand-700" />
            </div>
            <h3 class="mt-4 font-semibold text-brand-900">{r.title}</h3>
            <p class="mt-2 text-sm text-stone-600">{r.text}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- 7. Call to action -->
    <section class="pb-16">
      <div class="rounded-2xl bg-gradient-to-br from-brand-900 to-brand-800 p-8 text-center lg:p-12">
        <h2 class="font-display text-2xl text-white sm:text-3xl">
          Book {lowerName} in {area.name}
        </h2>
        <p class="mx-auto mt-4 max-w-xl text-brand-200">
          Urgent fix or a planned visit, the team is ready. Phone now or ask for a free estimate online.
        </p>
        <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
          <a
            href={business.phoneHref}
            class="inline-flex items-center gap-2 rounded-lg bg-amber-500 px-6 py-3 text-sm font-semibold text-brand-950 shadow-lg transition-all hover:bg-amber-400 hover:shadow-xl"
          >
            <Icon name="lucide:phone" class="size-5" />
            Call {business.phone}
          </a>
          <a
            href={contactUrl()}
            class="inline-flex items-center gap-2 rounded-lg border border-white/20 bg-white/10 px-6 py-3 text-sm font-semibold text-white backdrop-blur transition-all hover:bg-white/20"
          >
            <Icon name="lucide:message-square" class="size-5" />
            Free estimate
          </a>
        </div>
      </div>
    </section>

    <!-- 8. Internal links, cross-links, reviews -->
    <section class="pb-8">
      <SeoRelatedLinks area={area} service={service} />
    </section>

    <section class="pb-8">
      <SeoServiceAreas currentArea={area} service={service} />
    </section>

    <SeoTestimonials area={area} service={service} />
  </article>

  <!-- 9. FAQ with FAQPage schema -->
  <SeoFaq area={area} service={service} />
</BaseLayout>
