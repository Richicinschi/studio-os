#!/usr/bin/env bash
# review-package: write one file that holds everything a reviewer needs about
# a commit range: the commit list, a stat summary and the full diff with wide
# context. The reviewer reads it in a single call. Always pass the BASE you
# recorded before the task started, never HEAD~1, so a task of several
# commits is not cut down to its last one.
#
# Usage: review-package PLAN_FILE BASE HEAD [OUTFILE]
# Default OUTFILE: <repo-root>/.studio-work/sdd/<plan-basename>/review-<base7>..<head7>.diff
# The name carries the range, so a re-review after fixes gets a new file.
#
# Exit codes: 2 for bad arguments, a missing plan file or an unknown commit;
# 3 when HEAD is not a descendant of BASE or the range holds no commits.
set -euo pipefail

if [ "$#" -lt 3 ] || [ "$#" -gt 4 ]; then
  echo "usage: review-package PLAN_FILE BASE HEAD [OUTFILE]" >&2
  exit 2
fi

plan_file=$1
base_ref=$2
head_ref=$3
if [ ! -f "$plan_file" ]; then
  echo "no such plan file: $plan_file" >&2
  exit 2
fi

if ! git rev-parse --verify --quiet "$base_ref" > /dev/null; then
  echo "bad BASE: $base_ref" >&2
  exit 2
fi
if ! git rev-parse --verify --quiet "$head_ref" > /dev/null; then
  echo "bad HEAD: $head_ref" >&2
  exit 2
fi

# A HEAD taken from the wrong branch gives a range that is empty or does not
# start at BASE. Refuse it rather than write a misleading package.
if ! git merge-base --is-ancestor "$base_ref" "$head_ref"; then
  echo "HEAD is not a descendant of BASE: ${base_ref}..${head_ref}" >&2
  exit 3
fi
commit_count=$(git rev-list --count "${base_ref}..${head_ref}")
if [ "$commit_count" -eq 0 ]; then
  echo "empty commit range: ${base_ref}..${head_ref}" >&2
  exit 3
fi

if [ "$#" -eq 4 ]; then
  package=$4
else
  # Run the sibling through bash instead of executing it: unpacking a package
  # with some tools drops the executable bit.
  here=$(cd "$(dirname "$0")" && pwd)
  workspace=$("${BASH:-bash}" "$here/sdd-workspace" "$plan_file")
  package="$workspace/review-$(git rev-parse --short "$base_ref")..$(git rev-parse --short "$head_ref").diff"
fi

{
  printf '# Review package: %s..%s\n\n' "$base_ref" "$head_ref"
  printf '## Commits\n'
  git log --oneline "${base_ref}..${head_ref}"
  printf '\n## Files changed\n'
  git diff --stat "${base_ref}..${head_ref}"
  printf '\n## Diff\n'
  git diff -U10 "${base_ref}..${head_ref}"
} > "$package"

size=$(wc -c < "$package" | tr -d ' ')
echo "wrote ${package}: ${commit_count} commit(s), ${size} bytes"
