---
interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  ogImage?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}

// Replace both constants with the real brand name and a 1200x630 share image.
const SITE_NAME = 'Riverbend Plumbing Co';
const FALLBACK_OG_IMAGE = '/og-default.webp';

const { title: givenTitle, description, canonicalUrl, ogImage, schema, noindex = false } = Astro.props;

// Add the brand to the title unless the caller already did.
const fullTitle = givenTitle.includes(SITE_NAME) ? givenTitle : `${givenTitle} | ${SITE_NAME}`;

// No canonical passed in: build one from the path being rendered.
const canonical = canonicalUrl || new URL(Astro.url.pathname, Astro.site).href;
const imageHref = new URL(ogImage || FALLBACK_OG_IMAGE, Astro.site).href;
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:locale" content="en_US" />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageHref} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageHref} />

{schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
