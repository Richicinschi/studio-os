// ============================================================
// Business data
// ============================================================
// One object feeds the header, footer, meta tags, JSON-LD, the
// contact page and the about page. Replace each __TOKEN__ with
// the real value. Field names are what the page templates read,
// so rename nothing here without renaming it in src/pages too.
// ============================================================

export interface BusinessHours {
  /** Day label, e.g. "Monday - Friday" or "Saturday" */
  days: string;
  /** Opening times, e.g. "7:00 AM - 6:00 PM", or "Closed" */
  hours: string;
  /** schema.org DayOfWeek names this row covers, e.g. ["Monday", "Tuesday"]. Leave empty for a closed day. */
  dayOfWeek: string[];
  /** 24-hour opening time, "08:00". Leave '' when closed. */
  opens: string;
  /** 24-hour closing time, "17:00". Leave '' when closed. */
  closes: string;
}

export interface Address {
  street: string;
  city: string;
  /** Full state name, e.g. "Texas" */
  state: string;
  /** Two-letter code, e.g. "TX" */
  stateCode: string;
  zip: string;
  country: string;
}

export interface Coordinates {
  /** e.g. 40.0821 */
  lat: number;
  /** e.g. -83.0113 */
  lng: number;
}

export interface Business {
  // Identity
  name: string;
  /** Registered name, used in schema.org `legalName` */
  legalName: string;
  /** Short form for tight spots such as the mobile header */
  shortName: string;
  /** Owner or founder, shown on the about page and in schema */
  owner: string;
  /** One line under the logo or in the hero */
  tagline: string;
  /** One or two sentences, reused in meta tags and schema */
  description: string;
  /** schema.org type from the industry table in the guide, e.g. "Plumber" */
  schemaType: string;

  // Contact
  /** Shown to visitors, e.g. "(555) 555-0182" */
  phone: string;
  /** Link form, e.g. "tel:+15555550182" */
  phoneHref: string;
  /** Out-of-hours number; '' when there is none */
  phoneSecondary: string;
  email: string;

  // Place
  address: Address;
  coordinates: Coordinates;
  /** Human wording for the territory, e.g. "Harlan and Mercer Counties" */
  serviceRadius: string;

  // Online
  /** Live URL, https, no trailing slash */
  website: string;
  googleBusinessUrl: string;
  /** Use '' for any network the business is not on */
  socialMedia: {
    facebook: string;
    instagram: string;
    twitter: string;
    youtube: string;
    linkedin: string;
    nextdoor: string;
    yelp: string;
  };

  // Credentials
  /** Licence or registration number printed in footer and about page */
  license: string;
  yearEstablished: number;
  certifications: string[];

  // Operations
  hours: BusinessHours[];
  emergencyService: boolean;
  /** e.g. "Emergency callouts, day or night" */
  emergencyCta: string;

  // Branding files, relative to /public
  logo: string;
  logoWhite: string;
  /** 1200x630 */
  ogImage: string;
}

