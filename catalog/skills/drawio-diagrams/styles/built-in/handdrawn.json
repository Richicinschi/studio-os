{
  "name": "handdrawn",
  "$schema": "./../schema.json",
  "default": false,
  "palette": {
    "primary":   { "fillColor": "#ffe4b5", "strokeColor": "#b8651e" },
    "success":   { "fillColor": "#def0dc", "strokeColor": "#5c8a49" },
    "warning":   { "fillColor": "#fff4cc", "strokeColor": "#b8901a" },
    "accent":    { "fillColor": "#ffd9b3", "strokeColor": "#c25100" },
    "danger":    { "fillColor": "#ffcdbf", "strokeColor": "#a53d3d" },
    "neutral":   { "fillColor": "#f5e6d3", "strokeColor": "#8b7355" },
    "secondary": { "fillColor": "#e6d7e8", "strokeColor": "#7b4397" }
  },
  "roles": {
    "queue":    "warning",
    "security": "secondary",
    "database": "success",
    "service":  "primary",
    "external": "neutral",
    "error":    "danger",
    "gateway":  "accent"
  },
  "shapes": {
    "database":  "shape=cylinder3",
    "container": "startSize=30;swimlane",
    "decision":  "rhombus",
    "service":   "rounded=1",
    "external":  "dashed=1;rounded=1",
    "queue":     "rounded=1"
  },
  "font": {
    "fontSize": 12,
    "fontFamily": "Helvetica",
    "titleBold": true,
    "titleFontSize": 14
  },
  "edges": {
    "dashedFor": ["optional"],
    "arrow": "endFill=1;endArrow=classic",
    "style": "html=1;rounded=1;curved=1;jettySize=auto;orthogonalLoop=1;edgeStyle=orthogonalEdgeStyle"
  },
  "extras": {
    "globalStrokeWidth": 2,
    "sketch": true
  },
  "confidence": "high",
  "version": 1,
  "source": { "path": "styles/built-in/handdrawn.json", "type": "built-in" }
}
