---
import { Icon } from 'astro-icon/components';
import type { ServiceArea } from '../data/serviceAreas';
import type { ServiceType } from '../data/serviceTypes';
import { getReviewsForPage, reviews } from '../data/seoContent';
import { business } from '../data/business';

interface Props {
  area: ServiceArea;
  service?: ServiceType;
}

const { area, service } = Astro.props;

// Three reviews that fit this page best; the average covers every review on file.
const shown = getReviewsForPage(area.slug, service?.slug, 3);
const hasReviews = reviews.length > 0;
const average = hasReviews ? reviews.reduce((total, r) => total + r.rating, 0) / reviews.length : 0;

const ratingSchema = {
  '@context': 'https://schema.org',
  '@type': business.schemaType,
  name: business.name,
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: average.toFixed(1),
    bestRating: '5',
    worstRating: '1',
    reviewCount: reviews.length,
  },
  review: shown.map((r) => ({
    '@type': 'Review',
    author: { '@type': 'Person', name: r.author },
    datePublished: r.date,
    reviewRating: { '@type': 'Rating', ratingValue: r.rating, bestRating: 5 },
    reviewBody: r.text,
  })),
};

// "2025-03-09" becomes "March 9, 2025".
const prettyDate = (iso: string) =>
  new Date(`${iso}T00:00:00`).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const starClass = (filled: boolean) => (filled ? 'fill-amber-400 text-amber-400' : 'fill-stone-200 text-stone-200');
---

{hasReviews && (
<section class="mt-16">
  <h2 class="font-display text-2xl text-stone-900">Customer reviews</h2>

  <div class="mt-4 flex items-center gap-2">
    <div class="flex items-center gap-0.5">
      {[0, 1, 2, 3, 4].map((n) => (
        <Icon name="lucide:star" class:list={['size-5', starClass(n < Math.round(average))]} />
      ))}
    </div>
    <span class="text-sm font-semibold text-stone-800">{average.toFixed(1)} out of 5</span>
    <span class="text-sm text-stone-500">from {reviews.length} reviews</span>
  </div>

  <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {shown.map((r) => (
      <div class="rounded-xl border border-stone-200/60 bg-white p-6">
        <div class="flex items-center gap-0.5">
          {[0, 1, 2, 3, 4].map((n) => (
            <Icon name="lucide:star" class:list={['size-4', starClass(n < Math.floor(r.rating))]} />
          ))}
        </div>
        <p class="mt-3 text-sm leading-relaxed text-stone-600">{r.text}</p>
        <div class="mt-4 border-t border-stone-100 pt-3">
          <span class="text-sm font-semibold text-stone-800">{r.author}</span>
          <span class="block text-xs text-stone-400">{prettyDate(r.date)}</span>
        </div>
      </div>
    ))}
  </div>
</section>
)}

{hasReviews && <script type="application/ld+json" set:html={JSON.stringify(ratingSchema)} />}
