#!/usr/bin/env bash
# task-start PLAN_FILE TASK_NUMBER
#
# Opens a task in one call. It has the sibling skill's task-brief cut the
# task's text into the shared workspace, then notes the current commit as
# BASE, the point the task's review range starts from.
#
# Output, two lines:
#   brief: <path of the brief file>
#   base: <full SHA of HEAD>
# Exit codes: 2 for bad usage; task-brief's own code when it fails; 1 when
# task-brief printed no path.
set -euo pipefail

die_usage() {
  echo "usage: task-start PLAN_FILE TASK_NUMBER" >&2
  exit 2
}
[ "$#" -eq 2 ] || die_usage

plan_file=$1
task_no=$2

here=$(cd "$(dirname "$0")" && pwd)
sdd_scripts="$here/../../subagent-driven-development/scripts"
sdd_scripts=$(cd "$sdd_scripts" && pwd)

report=$("$sdd_scripts/task-brief" "$plan_file" "$task_no")

# task-brief reports "wrote <path>: <n> lines"; pull the path back out.
brief_path=$(printf '%s\n' "$report" | sed -n 's/^wrote \(.*\): [0-9][0-9]* lines$/\1/p')
if [ -z "$brief_path" ]; then
  echo "task-brief did not report a path: $report" >&2
  exit 1
fi

printf 'brief: %s\n' "$brief_path"
printf 'base: %s\n' "$(git rev-parse HEAD)"
