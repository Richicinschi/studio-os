---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  ogImage?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}

const { title, description, canonicalUrl, ogImage, schema, noindex } = Astro.props;

// Google Analytics is off by default. It sets cookies and sends every visitor's
// IP address to Google, so it loads only when ANALYTICS_ENABLED is true, and
// only in the production build. This is a site-wide switch, not a visitor's
// consent: when true, the script loads for every visitor. Set it to true only
// after the owner has decided how visitors consent: a consent tool on the site
// that holds this script back until a visitor agrees, or advice that no consent
// step is needed where the site's visitors are. Put the real GA4 id in both
// places in the block below too.
const ANALYTICS_ENABLED: boolean = false;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <!-- Fonts are self-hosted: put the .woff2 files in public/fonts/ (see the README there) and
         declare them with @font-face at the top of src/styles/global.css. Loading them from a
         font CDN would send each visitor's IP address to a third party. To preload the body
         font, uncomment and match the file name:
    <link rel="preload" href="/fonts/dm-sans-latin.woff2" as="font" type="font/woff2" crossorigin />
    -->

    <SEO
      title={title}
      description={description}
      canonicalUrl={canonicalUrl}
      ogImage={ogImage}
      schema={schema}
      noindex={noindex}
    />

    <!-- Analytics: off until ANALYTICS_ENABLED above is true. Or delete the block. -->
    {import.meta.env.PROD && ANALYTICS_ENABLED && (
      <>
        <script async src="https://www.googletagmanager.com/gtag/js?id=G-XXXXXXXXXX"></script>
        <script is:inline>
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          gtag('js', new Date());
          gtag('config', 'G-XXXXXXXXXX');
        </script>
      </>
    )}
  </head>

  <body class="flex min-h-screen flex-col bg-stone-50 font-body text-stone-900 antialiased">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
