#!/usr/bin/env bash
# task-done PLAN_FILE TASK_NUMBER BASE -- TEST_COMMAND [ARGS...]
#
# Closes a task in one call. It runs the test command, saves the whole
# output in the plan's workspace, shows the last lines, and writes the
# completion line to the ledger only when the command succeeded. A failing
# command leaves the ledger alone: the task is not complete.
#
# BASE is the SHA task-start printed. The ledger line covers BASE..HEAD.
# Exit codes: 2 for bad usage or an unknown BASE; otherwise the test
# command's own exit status.
set -euo pipefail

if [ "$#" -lt 5 ] || [ "$4" != "--" ]; then
  echo "usage: task-done PLAN_FILE TASK_NUMBER BASE -- TEST_COMMAND [ARGS...]" >&2
  exit 2
fi

plan_file=$1
task_no=$2
base_ref=$3
shift 4

here=$(cd "$(dirname "$0")" && pwd)
sdd_scripts=$(cd "$here/../../subagent-driven-development/scripts" && pwd)

if ! git rev-parse --verify --quiet "$base_ref" > /dev/null; then
  echo "bad BASE: $base_ref" >&2
  exit 2
fi

workspace=$("$sdd_scripts/sdd-workspace" "$plan_file")
test_log="$workspace/task-${task_no}-tests.log"
ledger_file="$workspace/progress.md"

# Rebuild the command as it would be typed, quoting any word that needs it.
shown=
for word in "$@"; do
  case "$word" in
    *[[:space:]\"\;\|\&]*) shown="${shown:+$shown }'$word'" ;;
    *) shown="${shown:+$shown }$word" ;;
  esac
done

status=0
"$@" > "$test_log" 2>&1 || status=$?

tail -n 5 "$test_log"
if [ "$status" -ne 0 ]; then
  echo "task-done: test command exited $status; Task $task_no NOT recorded (full output: $test_log)" >&2
  exit "$status"
fi

result=$(grep -v '^[[:space:]]*$' "$test_log" | tail -n 1) || result="(no output)"
if [ ! -f "$ledger_file" ]; then
  printf '# SDD ledger — plan: %s\n' "$plan_file" > "$ledger_file"
fi
short_base=$(git rev-parse --short=7 "$base_ref")
short_head=$(git rev-parse --short=7 HEAD)
entry="Task $task_no: complete (commits $short_base..$short_head, tests: $shown → $result)"
printf '%s\n' "$entry" >> "$ledger_file"
echo "ledger: $entry"
