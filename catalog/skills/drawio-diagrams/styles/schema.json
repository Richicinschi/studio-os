{
  "title": "drawio-diagrams style preset",
  "$id": "drawio-diagrams/styles/schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A named set of colours, shapes, fonts and edge settings that decides how a diagram looks.",
  "required": ["edges", "font", "shapes", "roles", "palette", "version", "name"],
  "properties": {
    "extras": {
      "properties": {
        "globalStrokeWidth": { "maximum": 6, "minimum": 0.5, "type": "number" },
        "sketch": { "$ref": "#/definitions/flag" }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "edges": {
      "required": ["arrow", "style"],
      "properties": {
        "dashedFor": { "items": { "$ref": "#/definitions/text" }, "type": "array" },
        "arrow": { "$ref": "#/definitions/text" },
        "style": { "$ref": "#/definitions/text" }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "font": {
      "required": ["fontSize", "fontFamily"],
      "properties": {
        "titleBold": { "$ref": "#/definitions/flag" },
        "titleFontSize": { "maximum": 48, "minimum": 8, "type": "integer" },
        "fontSize": { "maximum": 36, "minimum": 8, "type": "integer" },
        "fontFamily": { "$ref": "#/definitions/text" }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "shapes": {
      "description": "Style prefix per shape key: service, database, queue, decision, external, container.",
      "additionalProperties": { "$ref": "#/definitions/text" },
      "type": "object"
    },
    "roles": {
      "description": "Which palette slot each role uses. Keys: service, database, queue, gateway, error, external, security.",
      "patternProperties": {
        "^(service|database|queue|gateway|error|external|security)$": { "$ref": "#/definitions/slot" }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "palette": {
      "required": ["secondary", "neutral", "danger", "accent", "warning", "success", "primary"],
      "patternProperties": {
        "^(primary|success|warning|accent|danger|neutral|secondary)$": { "$ref": "#/definitions/pair" }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "source": {
      "properties": {
        "extracted_at": { "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "type": "string" },
        "path": { "$ref": "#/definitions/text" },
        "type": { "enum": ["hand-authored", "built-in", "image", "xml"], "type": "string" }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "confidence": { "enum": ["high", "medium", "low"], "type": "string" },
    "version": { "const": 1, "type": "integer" },
    "name": { "pattern": "^[0-9a-z][-_0-9a-z]*$", "type": "string" },
    "default": { "$ref": "#/definitions/flag" },
    "$schema": { "$ref": "#/definitions/text" }
  },
  "additionalProperties": false,
  "type": "object",
  "definitions": {
    "text": { "type": ["string"] },
    "flag": { "type": ["boolean"] },
    "pair": {
      "anyOf": [
        {
          "properties": {
            "fillColor": { "pattern": "^#([0-9a-fA-F]{2}){3}$", "type": "string" },
            "strokeColor": { "pattern": "^#([0-9a-fA-F]{2}){3}$", "type": "string" }
          },
          "required": ["strokeColor", "fillColor"],
          "additionalProperties": false,
          "type": "object"
        },
        { "type": "null" }
      ]
    },
    "slot": {
      "enum": ["secondary", "neutral", "danger", "accent", "warning", "success", "primary"],
      "type": "string"
    }
  }
}
