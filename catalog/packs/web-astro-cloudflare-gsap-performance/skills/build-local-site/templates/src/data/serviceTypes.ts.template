export const serviceTypes: ServiceType[] = [
  // 5 to 10 entries work well
];

/** Look a service up by slug; undefined when nothing matches. */
export function getServiceBySlug(slug: string): ServiceType | undefined {
  return serviceTypes.find((s) => s.slug === slug);
}

/** Display name for a slug; falls back to a title-cased slug. */
export function getServiceName(slug: string): string {
  const found = getServiceBySlug(slug);
  if (found) return found.name;
  return slug
    .split('-')
    .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
    .join(' ');
}

/** Lowest min and highest max across a service's tiers; zeros when none are set. */
export function getPriceSpan(service: ServiceType): { min: number; max: number } {
  const tiers = service.priceRanges;
  if (!tiers.length) return { min: 0, max: 0 };
  return {
    min: Math.min(...tiers.map((t) => t.min)),
    max: Math.max(...tiers.map((t) => t.max)),
  };
}

/** True when at least one tier has a real price. Pages show prices and price schema only then. */
export function hasPrices(service: ServiceType): boolean {
  return service.priceRanges.some((t) => t.max > 0);
}

/** Services flagged as urgent. */
export function getEmergencyServices(): ServiceType[] {
  return serviceTypes.filter((s) => s.emergency);
}

/** Services flagged for the homepage. */
export function getFeaturedServices(): ServiceType[] {
  return serviceTypes.filter((s) => s.featured);
}

/** Related services as full objects. */
export function getRelatedServices(slug: string): ServiceType[] {
  const base = getServiceBySlug(slug);
  if (!base) return [];
  return base.relatedServices
    .map((s) => getServiceBySlug(s))
    .filter((s): s is ServiceType => s !== undefined);
}
