#!/usr/bin/env bash
# sdd-workspace: print the scratch directory that belongs to one plan.
#
# Every plan gets its own folder under <repo-root>/.studio-work/sdd/. The
# folder holds the ledger (progress.md), task briefs, implementer reports and
# review packages. Keeping plans apart means a second plan run in the same
# checkout can never mistake the first plan's ledger for its own progress.
#
# The folder name is the plan file's name without ".md". Two plans can share
# that name (docs/a/plan.md and docs/b/plan.md), so each folder stores the
# owning plan's path in a file called plan-path (repo-relative when the plan
# is inside the repo, absolute otherwise). On a clash the name grows: first
# "<slug>-<parent dir>", then "<slug>-<parent dir>-2", "-3", and so on.
# A folder with no plan-path file is treated as unclaimed and is claimed by
# the plan that asks first; this keeps folders made by older versions usable.
#
# The folder sits in the working tree, not under .git/, because Claude Code
# refuses agent writes inside .git/ and an implementer must be able to write
# its report. A .gitignore holding "*" at .studio-work/sdd/ hides all of it
# from git without touching any tracked file.
#
# task-brief and review-package both call this script, so the location has
# one definition.
#
# Usage: sdd-workspace PLAN_FILE
set -euo pipefail

if [ "$#" -ne 1 ]; then
  echo "usage: sdd-workspace PLAN_FILE" >&2
  exit 2
fi

plan_file=$1
if [ ! -f "$plan_file" ]; then
  echo "no such plan file: $plan_file" >&2
  exit 2
fi

slug=$(basename "$plan_file" .md)
case "$slug" in
  ""|"."|"..")
    echo "cannot derive a workspace name from: $plan_file" >&2
    exit 2
    ;;
esac

# Use the physical spelling (pwd -P) everywhere so that the repo root and the
# plan path compare equal even where Git Bash mixes C:/x and /c/x forms.
repo_root=$(CDPATH='' cd -- "$(git rev-parse --show-toplevel)" && pwd -P)
sdd_root="$repo_root/.studio-work/sdd"

plan_parent=$(CDPATH='' cd -- "$(dirname "$plan_file")" && pwd -P)
plan_full="$plan_parent/$(basename "$plan_file")"
if [ "${plan_full#"$repo_root"/}" != "$plan_full" ]; then
  plan_key=${plan_full#"$repo_root"/}
else
  plan_key=$plan_full
fi

# claim DIR: succeed if DIR is this plan's folder. An unclaimed or missing
# folder is created and stamped with this plan's key on the spot.
claim() {
  local d=$1
  if [ -e "$d/plan-path" ]; then
    [ "$(cat "$d/plan-path")" = "$plan_key" ]
    return
  fi
  mkdir -p "$d"
  printf '%s\n' "$plan_key" > "$d/plan-path"
}

workspace="$sdd_root/$slug"
if ! claim "$workspace"; then
  parent_name=$(basename "$plan_parent")
  workspace="$sdd_root/$slug-$parent_name"
  if ! claim "$workspace"; then
    counter=2
    until claim "$sdd_root/$slug-$parent_name-$counter"; do
      counter=$((counter + 1))
    done
    workspace="$sdd_root/$slug-$parent_name-$counter"
  fi
fi

# Write the ignore file only when absent: a repo may track its own copy there
# (for example to version its ledgers) and must not have it reset.
if [ ! -e "$sdd_root/.gitignore" ]; then
  printf '*\n' > "$sdd_root/.gitignore"
fi

CDPATH='' cd -- "$workspace" && pwd
