---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { Icon } from 'astro-icon/components';
import { business } from '../../data/business';
import { serviceAreas } from '../../data/serviceAreas';
import { areaUrl, contactUrl } from '../../lib/urls';

// Badge colours per priority tier; anything unexpected falls back to the quietest style.
const badge: Record<string, string> = {
  primary: 'bg-brand-100 text-brand-700',
  secondary: 'bg-stone-200 text-stone-700',
  tertiary: 'bg-stone-100 text-stone-500',
};
const badgeFor = (priority: string) => badge[priority] ?? badge.tertiary;
---

<BaseLayout
  title={`Service Areas | ${business.name}`}
  description={`Towns covered by ${business.name} in the Fairmont region, with typical arrival times for each. Find yours.`}
>
  <Breadcrumbs crumbs={[{ label: 'Service Areas' }]} />

  <section class="py-12 lg:py-16">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <div class="max-w-3xl animate-fade-up">
        <h1 class="font-display text-4xl text-brand-900 sm:text-5xl">Towns we cover</h1>
        <!-- Home town and counties below are sample text: replace them. -->
        <p class="mt-4 text-lg leading-relaxed text-stone-600">
          {business.name} works out of Fairmont and drives to every town on this page across
          Harlan, Mercer and Dunn Counties. These are our neighbours, so we aim to get to you quickly.
        </p>
      </div>
    </div>
  </section>

  <section class="pb-16 lg:pb-24">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {serviceAreas.map((a, i) => (
          <a
            href={areaUrl(a.slug)}
            class={`card-hover group animate-fade-up rounded-xl border border-stone-200 bg-white p-6 stagger-${Math.min(i + 1, 6)}`}
          >
            <div class="flex items-center justify-between">
              <h2 class="font-display text-lg text-brand-900">{a.name}</h2>
              <span class={`inline-block rounded-full px-2 py-0.5 text-[11px] font-semibold capitalize ${badgeFor(a.priority)}`}>
                {a.priority}
              </span>
            </div>
            <p class="mt-1 text-sm text-stone-500">{a.county}</p>

            <div class="mt-3 flex items-center gap-4 text-sm text-stone-600">
              <span class="flex items-center gap-1.5">
                <Icon name="lucide:users" class="size-4 text-stone-400" />
                {a.population.toLocaleString()}
              </span>
              <span class="flex items-center gap-1.5">
                <Icon name="lucide:clock" class="size-4 text-brand-500" />
                {a.responseTime}
              </span>
            </div>

            <p class="mt-3 line-clamp-2 text-sm leading-relaxed text-stone-500">{a.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-brand-900">
    <div class="mx-auto max-w-7xl px-5 py-12 lg:px-8 lg:py-16">
      <div class="flex flex-col items-center gap-6 text-center sm:flex-row sm:justify-between sm:text-left">
        <div>
          <h2 class="font-display text-3xl text-white">Is your town on the list?</h2>
          <p class="mt-2 text-brand-200">
            If it is not, phone anyway. Anywhere in these three counties, we can probably reach you fast.
          </p>
        </div>
        <div class="flex shrink-0 flex-wrap gap-4">
          <a
            href={business.phoneHref}
            class="inline-flex items-center gap-2 rounded-lg bg-amber-500 px-6 py-3 text-sm font-semibold text-brand-950 shadow-lg transition-all hover:bg-amber-400"
          >
            <Icon name="lucide:phone" class="size-5" />
            {business.phone}
          </a>
          <a
            href={contactUrl()}
            class="inline-flex items-center gap-2 rounded-lg border border-white/20 bg-white/10 px-6 py-3 text-sm font-semibold text-white transition-all hover:bg-white/20"
          >
            Write to us
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
